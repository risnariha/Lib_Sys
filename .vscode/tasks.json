{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Build Library System",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.c",
                "book_management.c",
                "issue_return.c",
                "reports.c",
                "-o",
                "library_system.exe",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: gcc"
        }
    ]
}